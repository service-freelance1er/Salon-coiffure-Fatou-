<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>FATOU SALON – Coiffure, beauté et élégance</title>
<meta name="description" content="Salon de coiffure à Abidjan : tresses, perruques, coupes, maquillage. Réservez sur WhatsApp.">
<style>
:root{
  --bg:#eef4fb; --card:#ffffff; --ink:#0b1d3a; --muted:#6b7b93; --line:#e3eaf4;
  --navy:#0b1d3a; --navy2:#15345f; --blue:#19d3f2; --green:#25d366; --yellow:#ffc40c; --rose:#c2407e;
  --font:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
}
body.dark{--bg:#0b1a2e; --card:#14294a; --ink:#eef4ff; --muted:#9fb3cf; --line:#24406a}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font);background:#d9e3f0;color:var(--ink);-webkit-font-smoothing:antialiased}
body.dark{background:#050d18}
button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}
a{color:inherit}
input,select{font:inherit;color:var(--ink)}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
.app{max-width:480px;margin:0 auto;background:var(--bg);min-height:100vh;padding-bottom:92px;position:relative;overflow-x:hidden}

/* Barre du haut */
.topbar{background:#000;color:#fff;font-size:.8rem;display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 14px}
.topbar a{color:#fff;text-decoration:none;white-space:nowrap}

/* En-tête */
.head{background:var(--card);display:flex;align-items:center;justify-content:space-between;padding:10px 14px;position:sticky;top:0;z-index:20;box-shadow:0 2px 8px rgba(11,29,58,.08)}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none}
.logo{width:50px;height:50px;border-radius:50%;background:radial-gradient(circle at 30% 30%,#f6a6cf,#c2407e 60%,#5b2a86);display:grid;place-items:center;font-size:1.35rem}
.bname{display:block;font-weight:900;font-size:1.5rem;color:#0b2d6b;line-height:1;letter-spacing:.3px}
body.dark .bname{color:var(--ink)}
.bsub{display:block;font-size:.6rem;letter-spacing:2px;color:var(--navy2);margin-top:4px;font-weight:700}
.icons{display:flex;align-items:center;gap:4px}
.ibtn{position:relative;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;font-size:1.3rem;text-decoration:none}
.badge{position:absolute;top:-2px;right:-2px;min-width:20px;height:20px;border-radius:10px;background:var(--yellow);color:#0b1d3a;font-size:.72rem;font-weight:800;display:grid;place-items:center;padding:0 5px}
.menu{background:var(--card);border-bottom:1px solid var(--line);padding:6px 14px 12px;display:grid;gap:4px}
.menu[hidden]{display:none}
.menu a{text-decoration:none;padding:9px 4px;font-weight:600;border-bottom:1px solid var(--line)}

/* Accueil : hero */
.hero{background:linear-gradient(160deg,#0a1e3f 0%,#3b1d4f 60%,#c2407e 100%);color:#fff;padding:24px 18px 22px;position:relative;overflow:hidden}
.tag{color:var(--yellow);font-weight:700;font-size:.88rem}
.hero h1{font-size:2.1rem;line-height:1.08;font-weight:900;margin:10px 0 10px}
.hero h1 span{color:var(--blue)}
.lead{font-size:.95rem;opacity:.92;max-width:32ch;margin-bottom:16px}
.hero-art{font-size:4rem;margin:14px 0 4px;display:flex;gap:12px;justify-content:center;filter:drop-shadow(0 6px 10px rgba(0,0,0,.35))}
.btn{display:flex;align-items:center;justify-content:center;gap:8px;border-radius:999px;padding:14px 18px;font-weight:800;font-size:1rem;text-decoration:none;text-align:center;margin-top:10px}
.btn-blue{background:var(--blue);color:var(--navy)}
.btn-green{background:var(--green);color:#fff}
.btn-block{width:100%}
.dots{display:flex;gap:7px;align-items:center;justify-content:center;margin-top:14px;color:#fff;font-size:1.1rem}
.dots i{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.4);display:inline-block}
.dots i.on{background:#fff}

/* Catégories rondes */
.cats{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;padding:14px 10px;background:var(--navy);border-top:1px solid #1c3f6e}
.cat{text-align:center;text-decoration:none;color:#fff;font-size:.72rem;font-weight:700}
.round{width:62px;height:62px;border-radius:50%;margin:0 auto 6px;background:var(--navy2);border:2px solid var(--blue);display:grid;place-items:center;font-size:1.8rem}
.cat:hover .round{background:#1d4a85}

/* Sections */
.section{padding:16px 14px 4px}
.sec-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.sec-head h2{font-size:1.3rem;font-weight:900}
.sec-head a{color:#0a8fb0;font-weight:700;font-size:.9rem;text-decoration:none}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.card{background:var(--card);border-radius:14px;overflow:hidden;position:relative;display:flex;flex-direction:column;box-shadow:0 2px 6px rgba(11,29,58,.07)}
.promo{position:absolute;top:8px;left:8px;background:var(--blue);color:var(--navy);font-weight:900;font-size:.72rem;padding:4px 8px;border-radius:8px;z-index:1}
.fav{position:absolute;top:6px;right:6px;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.92);display:grid;place-items:center;font-size:.95rem;z-index:1}
.pic{height:150px;display:grid;place-items:center;font-size:4rem}
.pic img{width:100%;height:100%;object-fit:cover}
.cbody{padding:10px;display:flex;flex-direction:column;gap:6px;flex:1}
.cbody h3{font-size:.88rem;font-weight:700;line-height:1.25}
.price{font-weight:900;color:#0a8fb0;font-size:.95rem}
body.dark .price{color:var(--blue)}
.price s{color:var(--muted);font-weight:400;font-size:.75rem;margin-left:4px}
.add{margin-top:auto;background:var(--blue);color:var(--navy);border-radius:999px;padding:9px;font-weight:800;font-size:.8rem;width:100%}
.add:hover{filter:brightness(1.05)}

/* Bandeau avantages (noir) */
.perks{background:#000;color:#fff;display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:14px 8px;margin-top:16px;text-align:center;font-size:.72rem;font-weight:600}
.perks span{display:block;font-size:1.3rem;margin-bottom:3px}

/* Pages internes */
.page{padding:18px 14px 10px}
.page h1{font-size:1.45rem;font-weight:900;margin-bottom:12px}
.page h2{font-size:1.05rem;font-weight:800;margin:18px 0 6px}
.page p,.page li{font-size:.94rem;line-height:1.55;margin-bottom:8px}
.page ul{padding-left:18px}
.page a{color:#0a8fb0;font-weight:700}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.chip{border:1.5px solid var(--navy);border-radius:999px;padding:7px 14px;font-size:.85rem;font-weight:700;text-decoration:none;color:var(--ink)}
.chip.on{background:var(--navy);color:#fff}
body.dark .chip.on{background:var(--blue);color:var(--navy);border-color:var(--blue)}
.catlist{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.catbox{background:var(--card);border-radius:14px;padding:18px 10px;text-align:center;text-decoration:none;font-weight:800;box-shadow:0 2px 6px rgba(11,29,58,.07)}
.catbox span{display:block;font-size:2.2rem;margin-bottom:6px}
.input{width:100%;border:1.5px solid var(--line);border-radius:12px;padding:12px 14px;background:var(--card);margin-bottom:12px}
.input:focus{outline:none;border-color:var(--blue)}
.field{margin-bottom:12px}
.field label{display:block;font-size:.85rem;font-weight:700;margin-bottom:5px}
.empty{color:var(--muted);text-align:center;padding:26px 0}
.panel{background:var(--card);border-radius:14px;padding:14px;margin-bottom:12px;box-shadow:0 2px 6px rgba(11,29,58,.07)}
.panel p{margin-bottom:10px}
.panel a{color:#0a8fb0;font-weight:700}
.line{display:grid;grid-template-columns:54px 1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.mini{width:54px;height:54px;border-radius:10px;display:grid;place-items:center;font-size:1.6rem;overflow:hidden}
.mini img{width:100%;height:100%;object-fit:cover}
.line b{font-size:.9rem}
.qty{display:flex;align-items:center;gap:10px;margin-top:6px}
.qty button{width:30px;height:30px;border-radius:50%;border:1.5px solid var(--ink);font-weight:800;color:var(--ink)}
.line strong{font-size:.9rem;white-space:nowrap}
.total{display:flex;justify-content:space-between;font-weight:900;font-size:1.15rem;padding:14px 0 4px}
.note{font-size:.8rem;color:var(--muted);margin:4px 0 12px}
.result{margin-top:10px}
footer{padding:18px 14px 26px;text-align:center;font-size:.8rem;color:var(--muted)}
footer a{color:var(--muted)}

/* Navigation du bas */
.bottom{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;background:var(--card);display:grid;grid-template-columns:repeat(5,1fr);padding:8px 4px calc(8px + env(safe-area-inset-bottom,0px));box-shadow:0 -4px 14px rgba(11,29,58,.08);z-index:25}
.bottom a{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:.7rem;color:var(--muted);font-weight:600;text-decoration:none;position:relative}
.bottom a .e{font-size:1.35rem}
.bottom a.active{color:var(--ink);font-weight:800}
.bottom .badge{top:-4px;right:calc(50% - 24px)}

/* WhatsApp rond */
.wa-fab{position:fixed;right:14px;bottom:96px;width:54px;height:54px;border-radius:50%;background:var(--green);color:#fff;display:grid;place-items:center;font-size:1.6rem;text-decoration:none;box-shadow:0 6px 16px rgba(37,211,102,.4);z-index:26}

/* Message court */
#toast{position:fixed;left:50%;bottom:160px;transform:translateX(-50%);background:var(--navy);color:#fff;padding:10px 16px;border-radius:12px;font-size:.9rem;opacity:0;pointer-events:none;transition:opacity .2s;z-index:50;max-width:90%;text-align:center}
#toast.show{opacity:1}

@media (min-width:600px){.grid{grid-template-columns:repeat(4,1fr)}.pic{height:170px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<div class="app">

  <div class="topbar">
    <span>📍 Abidjan, Côte d'Ivoire</span>
    <a id="wa-top" href="#" target="_blank" rel="noopener">📞 WhatsApp : 55 06 16 53</a>
  </div>

  <header class="head">
    <a class="brand" href="#/">
      <span class="logo" aria-hidden="true">💇‍♀️</span>
      <span><b class="bname">FATOU SALON</b><small class="bsub">COIFFURE • BEAUTÉ • ÉLÉGANCE</small></span>
    </a>
    <div class="icons">
      <button class="ibtn" data-action="dark" aria-label="Mode sombre">🌙</button>
      <a class="ibtn" href="#/panier" aria-label="Panier">🛒<span class="badge" data-count>0</span></a>
      <button class="ibtn" data-action="menu" aria-label="Menu">☰</button>
    </div>
  </header>

  <nav class="menu" id="menu" hidden>
    <a href="#/">Accueil</a>
    <a href="#/vetements">Toutes les prestations</a>
    <a href="#/categories">Catégories</a>
    <a href="#/recherche">Recherche</a>
    <a href="#/conseil">Conseils coiffure</a>
    <a href="#/suivi">Suivre ma réservation</a>
    <a href="#/contact">Contact</a>
  </nav>

  <main id="view"></main>

  <footer>
    <p>© <span id="year"></span> FATOU SALON · Abidjan, Côte d'Ivoire</p>
    <p><a href="#/cgu">CGU</a> · <a href="#/confidentialite">Confidentialité</a> · <a href="#/mentions">Mentions légales</a></p>
  </footer>
</div>

<nav class="bottom" aria-label="Navigation principale">
  <a href="#/" data-nav="home"><span class="e">🏠</span>Accueil</a>
  <a href="#/categories" data-nav="categories"><span class="e">🔲</span>Catégories</a>
  <a href="#/recherche" data-nav="recherche"><span class="e">🔍</span>Recherche</a>
  <a href="#/panier" data-nav="panier"><span class="e">🛒</span>Panier<span class="badge" data-count>0</span></a>
  <a href="#/contact" data-nav="contact"><span class="e">📞</span>Contact</a>
</nav>

<a class="wa-fab" id="wa-fab" href="#" target="_blank" rel="noopener" aria-label="Discuter sur WhatsApp">💬</a>
<div id="toast" role="status" aria-live="polite"></div>

<script>
/* ============ À PERSONNALISER ============ */
// Numéro WhatsApp : indicatif 225 + numéro complet, sans + ni espaces.
// ATTENTION : 55061653 n'a que 8 chiffres ; vérifiez le numéro complet.
const WA_NUMBER = "22555061653";
const SHOP_NAME = "FATOU SALON";

// Pour une vraie photo : mettez le lien dans image (ex. "https://…/tresses.jpg").
const PRODUCTS = [
  { id:1,  name:"Tresses Braids Élégantes", cat:"Tresses",      price:12000, old:15000, pct:20, emoji:"🧶", bg:"#f6dbe0", image:"" },
  { id:2,  name:"Perruque Brésilienne",     cat:"Perruques",    price:15000, old:20000, pct:25, emoji:"👩‍🦱", bg:"#e7e0f4", image:"" },
  { id:3,  name:"Coiffure Enfant",          cat:"Coupe Femme",  price:10000, old:14000, pct:30, emoji:"🧒", bg:"#fbeccb", image:"" },
  { id:4,  name:"Maquillage + Coiffure",    cat:"Maquillage",   price:18000, old:21000, pct:15, emoji:"💄", bg:"#f6dbe0", image:"" },
  { id:5,  name:"Coupe Femme Moderne",      cat:"Coupe Femme",  price:8000,  old:null,  pct:0,  emoji:"✂️", bg:"#dbe7f7", image:"" },
  { id:6,  name:"Coupe Homme Dégradé",      cat:"Coupe Homme",  price:5000,  old:6000,  pct:17, emoji:"💈", bg:"#dbe7f7", image:"" },
  { id:7,  name:"Box Braids Longues",       cat:"Tresses",      price:25000, old:null,  pct:0,  emoji:"🧶", bg:"#f6dbe0", image:"" },
  { id:8,  name:"Perruque Lace Frontal",    cat:"Perruques",    price:35000, old:40000, pct:13, emoji:"👩‍🦱", bg:"#e7e0f4", image:"" },
  { id:9,  name:"Maquillage Soirée",        cat:"Maquillage",   price:12000, old:null,  pct:0,  emoji:"💄", bg:"#f6dbe0", image:"" },
  { id:10, name:"Soin Capillaire",          cat:"Coupe Femme",  price:9000,  old:null,  pct:0,  emoji:"🧴", bg:"#dff3ea", image:"" },
  { id:11, name:"Coupe Homme & Barbe",      cat:"Coupe Homme",  price:7000,  old:null,  pct:0,  emoji:"🧔", bg:"#dbe7f7", image:"" },
  { id:12, name:"Brushing Express",         cat:"Coupe Femme",  price:6000,  old:7000,  pct:14, emoji:"💇‍♀️", bg:"#ece3f7", image:"" }
];
const CATEGORIES = [
  { name:"Tresses",     emoji:"🧶" },
  { name:"Perruques",   emoji:"👩‍🦱" },
  { name:"Coupe Femme", emoji:"✂️" },
  { name:"Coupe Homme", emoji:"💈" },
  { name:"Maquillage",  emoji:"💄" }
];
/* ========================================== */

const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmt = n => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, " ") + " FCFA";
const byId = id => PRODUCTS.find(p => p.id == id);
const waUrl = msg => "https://wa.me/" + WA_NUMBER + (msg ? "?text=" + encodeURIComponent(msg) : "");

function load(key, fallback){
  try { const v = JSON.parse(localStorage.getItem(key)); return v || fallback; } catch(e){ return fallback; }
}
function store(key, value){
  try { localStorage.setItem(key, JSON.stringify(value)); } catch(e){}
}

let cart = load("salon_cart", {});
let bookings = load("salon_bookings", {});
if (localStorage.getItem("salon_dark") === "1") document.body.classList.add("dark");

const cartCount = () => Object.values(cart).reduce((a, b) => a + b, 0);
const cartTotal = () => Object.keys(cart).reduce((s, id) => byId(id) ? s + byId(id).price * cart[id] : s, 0);

let toastTimer = null;
function toast(msg){
  const t = $("#toast");
  t.textContent = msg;
  t.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove("show"), 1800);
}

function updateCounts(){
  const n = cartCount();
  document.querySelectorAll("[data-count]").forEach(el => { el.textContent = n; });
}

function visual(p){
  return p.image
    ? `<img src="${esc(p.image)}" alt="${esc(p.name)}" loading="lazy">`
    : `<span aria-hidden="true">${p.emoji}</span>`;
}

function serviceCard(p){
  return `
  <article class="card">
    ${p.pct ? `<span class="promo">-${p.pct}%</span>` : ""}
    <button class="fav" data-action="fav" aria-label="Ajouter aux favoris" aria-pressed="false">🤍</button>
    <div class="pic" style="background:${p.bg}">${visual(p)}</div>
    <div class="cbody">
      <h3>${esc(p.name)}</h3>
      <p class="price">${fmt(p.price)}${p.old ? `<s>${fmt(p.old)}</s>` : ""}</p>
      <button class="add" data-action="add" data-id="${p.id}">🛒 Réserver</button>
    </div>
  </article>`;
}

/* ---------- Pages ---------- */
function viewHome(){
  return `
  <section class="hero">
    <p class="tag">⭐ VOTRE SALON DE COIFFURE</p>
    <h1>Découvrez<br>notre collection<br><span>beauté tendance !</span></h1>
    <p class="lead">Femmes, Hommes et Enfants. Retrouvez coiffures, tresses, perruques et soins. Choisissez votre style et réservez directement sur WhatsApp.</p>
    <div class="hero-art" aria-hidden="true">💇‍♀️💈</div>
    <a class="btn btn-blue" href="#/vetements">💇‍♀️ Voir les coiffures</a>
    <a class="btn btn-green" href="${waUrl("Bonjour FATOU SALON, je veux réserver.")}" target="_blank" rel="noopener">🟢 Réserver sur WhatsApp</a>
    <div class="dots" aria-hidden="true"><i class="on"></i><i></i><i></i><i></i>›</div>
  </section>

  <nav class="cats" aria-label="Catégories">
    ${CATEGORIES.map(c => `
      <a class="cat" href="#/vetements/${encodeURIComponent(c.name)}">
        <span class="round" aria-hidden="true">${c.emoji}</span>${c.name}
      </a>`).join("")}
  </nav>

  <section class="section">
    <div class="sec-head"><h2>🏷️ Nos Prestations</h2><a href="#/vetements">Voir tout →</a></div>
    <div class="grid">${PRODUCTS.slice(0, 4).map(serviceCard).join("")}</div>
  </section>

  <div class="perks">
    <div><span>🚚</span>Déplacement à domicile<br>à Abidjan</div>
    <div><span>🛡️</span>Paiement sécurisé<br>(Orange Money, Wave)</div>
    <div><span>🎧</span>Service client<br>à votre écoute</div>
  </div>`;
}

function viewVetements(cat){
  const name = cat ? decodeURIComponent(cat) : "";
  const list = name ? PRODUCTS.filter(p => p.cat === name) : PRODUCTS;
  return `
  <section class="page">
    <h1>${name ? esc(name) : "Toutes les prestations"}</h1>
    <div class="chips">
      <a class="chip ${name ? "" : "on"}" href="#/vetements">Tous</a>
      ${CATEGORIES.map(c => `<a class="chip ${c.name === name ? "on" : ""}" href="#/vetements/${encodeURIComponent(c.name)}">${c.name}</a>`).join("")}
    </div>
    <div class="grid">${list.length ? list.map(serviceCard).join("") : `<p class="empty">Aucune prestation dans cette catégorie.</p>`}</div>
  </section>`;
}

function viewCategories(){
  return `
  <section class="page">
    <h1>Catégories</h1>
    <div class="catlist">
      ${CATEGORIES.map(c => `<a class="catbox" href="#/vetements/${encodeURIComponent(c.name)}"><span>${c.emoji}</span>${c.name}</a>`).join("")}
    </div>
  </section>`;
}

function searchResults(q){
  const term = q.trim().toLowerCase();
  if (!term) return `<p class="empty">Tapez le nom d'une prestation ou une catégorie.</p>`;
  const list = PRODUCTS.filter(p => p.name.toLowerCase().includes(term) || p.cat.toLowerCase().includes(term));
  return list.length
    ? `<div class="grid">${list.map(serviceCard).join("")}</div>`
    : `<p class="empty">Aucun résultat pour « ${esc(q)} ».</p>`;
}

function viewSearch(){
  return `
  <section class="page">
    <h1>Recherche</h1>
    <input class="input" id="q" type="search" placeholder="Rechercher une prestation…" aria-label="Rechercher une prestation">
    <div id="results">${searchResults("")}</div>
  </section>`;
}

function viewCart(){
  const ids = Object.keys(cart).filter(id => byId(id));
  if (!ids.length) {
    return `
    <section class="page">
      <h1>Ma réservation</h1>
      <p class="empty">Aucune prestation sélectionnée.</p>
      <a class="btn btn-blue" href="#/vetements">Voir les coiffures</a>
    </section>`;
  }
  const lines = ids.map(id => {
    const p = byId(id), q = cart[id];
    return `
    <div class="line">
      <div class="mini" style="background:${p.bg}">${visual(p)}</div>
      <div><b>${esc(p.name)}</b>
        <div class="qty">
          <button data-action="dec" data-id="${id}" aria-label="Retirer un">−</button>
          <span>${q}</span>
          <button data-action="inc" data-id="${id}" aria-label="Ajouter un">+</button>
        </div>
      </div>
      <strong>${fmt(p.price * q)}</strong>
    </div>`;
  }).join("");

  return `
  <section class="page">
    <h1>Ma réservation</h1>
    <div class="panel">
      ${lines}
      <div class="total"><span>Total</span><span>${fmt(cartTotal())}</span></div>
    </div>

    <div class="panel">
      <h2 style="margin-top:0">Vos informations</h2>
      <div class="field"><label for="f-nom">Nom complet</label><input class="input" id="f-nom" autocomplete="name"></div>
      <div class="field"><label for="f-quartier">Quartier</label><input class="input" id="f-quartier" placeholder="ex. Cocody, Yopougon, Marcory"></div>
      <div class="field"><label for="f-tel">Téléphone</label><input class="input" id="f-tel" type="tel" autocomplete="tel" placeholder="ex. 0555061653"></div>
      <div class="field"><label for="f-date">Date souhaitée</label><input class="input" id="f-date" type="date"></div>
      <div class="field"><label for="f-style">Style choisi</label>
        <input class="input" id="f-style" placeholder="ex. Tresses longues, coupe dégradée…">
      </div>
      <div class="field"><label for="f-paie">Moyen de paiement</label>
        <select class="input" id="f-paie">
          <option>Orange Money</option><option>Wave</option><option>MTN MoMo</option><option>Espèces sur place</option>
        </select>
      </div>
      <p class="note">Votre réservation est envoyée sur WhatsApp. Nous confirmons l'horaire avec vous.</p>
      <button class="btn btn-green btn-block" data-action="book">💬 Réserver sur WhatsApp</button>
    </div>
  </section>`;
}

function viewContact(){
  return `
  <section class="page">
    <h1>Contact</h1>
    <div class="panel">
      <p>📍 Abidjan, Côte d'Ivoire</p>
      <p>📞 WhatsApp : 55 06 16 53</p>
      <p>Pour une réservation ou une question, écrivez-nous directement.</p>
      <a class="btn btn-green btn-block" href="${waUrl("Bonjour FATOU SALON, j'ai une question.")}" target="_blank" rel="noopener">💬 Écrire sur WhatsApp</a>
    </div>
    <div class="panel">
      <p><a href="#/suivi">📅 Suivre ma réservation</a></p>
      <p><a href="#/conseil">💡 Conseils coiffure</a></p>
      <p><a href="#/vetements">💇‍♀️ Voir les prestations</a></p>
    </div>
  </section>`;
}

function viewTrack(){
  return `
  <section class="page">
    <h1>Suivre ma réservation</h1>
    <p>Entrez la référence reçue après votre réservation (ex. RDV-AB12CD).</p>
    <input class="input" id="track-id" placeholder="Référence de réservation" aria-label="Référence de réservation" autocapitalize="characters">
    <button class="btn btn-blue btn-block" data-action="track">Voir l'état</button>
    <div class="result" id="track-result"></div>
