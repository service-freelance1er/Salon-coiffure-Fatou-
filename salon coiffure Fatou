function viewLegal(){
  return `
  <section class="page">
    <h1>Mentions légales</h1>
    <p>Éditeur : ${SHOP_NAME}, Abidjan, Côte d'Ivoire.</p>
    <p>Contact : WhatsApp 55 06 16 53.</p>
    <p><em>À compléter avec le nom du responsable et l'adresse légale du salon.</em></p>
  </section>`;
}

const ROUTES = {
  "": viewHome,
  "vetements": viewVetements,
  "categories": viewCategories,
  "recherche": viewSearch,
  "panier": viewCart,
  "contact": viewContact,
  "suivi": viewTrack,
  "conseil": viewAdvice,
  "cgu": viewCgu,
  "confidentialite": viewPrivacy,
  "mentions": viewLegal
};

function render(){
  const parts = location.hash.replace(/^#\/?/, "").split("/");
  const route = parts[0] || "";
  const fn = ROUTES[route] || viewHome;
  $("#view").innerHTML = fn(parts[1]);
  $("#menu").hidden = true;
  const active = route === "" ? "home" : route;
  document.querySelectorAll("[data-nav]").forEach(a => {
    a.classList.toggle("active", a.dataset.nav === active);
  });
  updateCounts();
  window.scrollTo(0, 0);
}

/* ---------- Actions ---------- */
function placeBooking(){
  const val = id => { const el = document.getElementById(id); return el ? el.value.trim() : ""; };
  const nom = val("f-nom"), quartier = val("f-quartier"), tel = val("f-tel");
  const date = val("f-date"), style = val("f-style"), paie = val("f-paie");
  const ids = Object.keys(cart).filter(id => byId(id));
  if (!ids.length) { toast("Aucune prestation sélectionnée."); return; }
  if (!nom || !quartier || !tel || !date) { toast("Remplissez le nom, le quartier, le téléphone et la date."); return; }

  const ref = "RDV-" + Date.now().toString(36).toUpperCase().slice(-6);
  const total = cartTotal();
  const lines = ids.map(id => `- ${cart[id]} x ${byId(id).name} (${fmt(byId(id).price * cart[id])})`);
  const msg = `Bonjour FATOU SALON, je veux réserver (réf. ${ref}) :\n${lines.join("\n")}\n\nNom : ${nom}\nQuartier : ${quartier}\nTéléphone : ${tel}\nDate souhaitée : ${date}\nStyle : ${style || "à définir"}\nPaiement : ${paie}\nTotal : ${fmt(total)}`;

  bookings[ref] = { date: new Date().toLocaleDateString("fr-FR"), rdv: date, total: total, status: "Demande envoyée" };
  store("salon_bookings", bookings);
  cart = {};
  store("salon_cart", cart);

  window.open(waUrl(msg), "_blank", "noopener");
  toast("Réservation " + ref + " envoyée sur WhatsApp.");
  render();
}

function trackBooking(){
  const ref = (document.getElementById("track-id").value || "").trim().toUpperCase();
  const b = bookings[ref];
  document.getElementById("track-result").innerHTML = b
    ? `<div class="panel"><b>${esc(ref)}</b><p>Demandé le : ${esc(b.date)}</p><p>Date souhaitée : ${esc(b.rdv)}</p><p>Total : ${fmt(b.total)}</p><p>État : ${esc(b.status)}</p></div>`
    : `<p class="empty">Référence introuvable. Vérifiez-la ou écrivez-nous sur WhatsApp.</p>`;
}

document.addEventListener("click", e => {
  const el = e.target.closest("[data-action]");
  if (!el) return;
  const act = el.dataset.action;

  if (act === "add") {
    const id = el.dataset.id;
    cart[id] = (cart[id] || 0) + 1;
    store("salon_cart", cart);
    updateCounts();
    toast("Ajouté à votre réservation ✓");
  } else if (act === "inc" || act === "dec") {
    const id = el.dataset.id;
    cart[id] = (cart[id] || 0) + (act === "inc" ? 1 : -1);
    if (cart[id] <= 0) delete cart[id];
    store("salon_cart", cart);
    render();
  } else if (act === "fav") {
    const on = !el.classList.contains("on");
    el.classList.toggle("on", on);
    el.setAttribute("aria-pressed", String(on));
    el.textContent = on ? "❤️" : "🤍";
  } else if (act === "dark") {
    document.body.classList.toggle("dark");
    store("salon_dark", document.body.classList.contains("dark") ? "1" : "0");
  } else if (act === "menu") {
    const m = document.getElementById("menu");
    m.hidden = !m.hidden;
  } else if (act === "book") {
    placeBooking();
  } else if (act === "track") {
    trackBooking();
  }
});

document.addEventListener("input", e => {
  if (e.target.id === "q") {
    const box = document.getElementById("results");
    if (box) box.innerHTML = searchResults(e.target.value);
  }
});

window.addEventListener("hashchange", render);

/* Liens WhatsApp */
document.getElementById("wa-top").href = waUrl("Bonjour FATOU SALON, je souhaite des informations.");
document.getElementById("wa-fab").href = waUrl("Bonjour FATOU SALON, je souhaite des informations.");
document.getElementById("year").textContent = new Date().getFullYear();
render();
</script>
